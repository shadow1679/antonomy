{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/web/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/web",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/web/:path*",
      "destination": "/:path*",
      "permanent": false
    },
    {
      "source": "/nest",
      "destination": "/nest.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/((?!sim/|web/).*)",
      "destination": "/web/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.mjs",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
